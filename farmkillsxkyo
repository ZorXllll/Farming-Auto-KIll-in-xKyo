local function loadHistory()
    if pcall(function() return isfile and isfile("KyoOnTop") end) then
        local success, content = pcall(readfile, "KyoOnTop")
        if success and content then
            local decodedSuccess, decoded = pcall(HttpService.JSONDecode, HttpService, content)
            if decodedSuccess and type(decoded) == "table" then
                AllIDs = decoded
            end
        end
    end
    
    if #AllIDs == 0 or AllIDs[1] ~= actualHour then
        AllIDs = {actualHour}
        pcall(writefile, "KyoOnTop", HttpService:JSONEncode(AllIDs))
    end
end
pcall(loadHistory)

-- Global State & Whitelist System
_G.autokillall = true
_G.whitelistTable = {} 
_G.friendsCache = {}
_G.FriendsWhitelistActive = false

function isWhitelisted(targetPlayer)
    if not targetPlayer or targetPlayer == player then return true end
    local targetNameLower = targetPlayer.Name:lower()
    local targetDisplayLower = targetPlayer.DisplayName:lower()
    if table.find(_G.whitelistTable, targetNameLower) or table.find(_G.whitelistTable, targetDisplayLower) then return true end
    return (_G.FriendsWhitelistActive and _G.friendsCache[targetPlayer.UserId]) and true or false
end

-- AutoKillLobby Implementation
local function AutoKillLobby()
    local targetList = Players:GetPlayers()
    
    for _, targetPlayer in ipairs(targetList) do
        if targetPlayer ~= player and targetPlayer.Character and not isWhitelisted(targetPlayer) then
            local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if tRoot and tHumanoid and tHumanoid.Health > 0 then
                local startTime = tick()
                while tick() - startTime < 0.3 and tHumanoid.Health > 0 and targetPlayer.Character and targetPlayer.Character.Parent do
                    local myChar = player.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
                    
                    if myChar and myRoot and myHumanoid then
                        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1)
                        
                        local tool = myChar:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
                        if tool then
                            if tool.Parent ~= myChar then
                                myHumanoid:EquipTool(tool)
                            end
                            tool:Activate()
                        end
                        
                        local remotes = ReplicatedStorage:FindFirstChild("RemotesEvent")
                        if remotes and remotes:FindFirstChild("SizeChanged") then
                            remotes.SizeChanged:FireServer(1)
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
            end
        end
    end
end

