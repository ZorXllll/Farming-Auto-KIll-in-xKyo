-- Auto-Kill Logic Integration
_G.autokillall = true

local function AutoKillLobby()
    local targetList = Players:GetPlayers()
    
    for _, targetPlayer in ipairs(targetList) do
        if targetPlayer ~= player and targetPlayer.Character then
            local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if tRoot and tHumanoid and tHumanoid.Health > 0 then
                local startTime = tick()
                while tick() - startTime < 0.3 and tHumanoid.Health > 0 and targetPlayer.Character and targetPlayer.Character.Parent do
                    local myChar = player.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
                    
                    if myChar and myRoot and myHumanoid then
                        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 0)
                        
                        local tool = myChar:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
                        if tool then
                            if tool.Parent ~= myChar then
                                myHumanoid:EquipTool(tool)
                            end
                            tool:Activate()
                        end
                        
                        local remotes = ReplicatedStorage:FindFirstChild("RemotesEvent")
                        if remotes and remotes:FindFirstChild("SizeChanged") then
                            remotes.SizeChanged:FireServer(1)
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if _G.autokillall and player.Character and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            AutoKillLobby()
        end
        RunService.Heartbeat:Wait() 
    end
end)

