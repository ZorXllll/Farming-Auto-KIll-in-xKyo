    KillsLabel.Text = "Total Kills: " .. totalKills
    GainedLabel.Text = "Gained Kills: " .. sessionKills
end

local function setupLeaderboardTracking()
    local leaderstats = player:WaitForChild("leaderstats", 15)
    if not leaderstats then return end

    local killsValue = leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("Kills ")

    if killsValue and (killsValue:IsA("IntValue") or killsValue:IsA("NumberValue")) then
        local lastKills = killsValue.Value
        totalKills = lastKills
        
        killsValue.Changed:Connect(function(newVal)
            local diff = newVal - lastKills
            if diff > 0 then
                sessionKills = sessionKills + diff
            end
            lastKills = newVal
            totalKills = newVal
            UpdateDisplay()
        end)
    end
    
    UpdateDisplay()
end
task.spawn(setupLeaderboardTracking)

