end)

function GetNextServerID()
    -- Changed sortOrder to Asc to find open public servers quicker
    local url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100'
    if foundAnything ~= "" then
        url = url .. '&cursor=' .. foundAnything
    end
    
    local success, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if not success or not res or not res.data then return nil end
    
    if res.nextPageCursor and res.nextPageCursor ~= "" and res.nextPageCursor ~= "null" then
        foundAnything = res.nextPageCursor
    else
        foundAnything = ""
    end

    local validServers = {}
    for _, v in pairs(res.data) do
        local ID = tostring(v.id)
        local playing = tonumber(v.playing) or 0
        local maxPlayers = tonumber(v.maxPlayers) or 0
        
        -- Relaxed filter to >= 1 player so it never gets stuck
        if playing >= 1 and playing < (maxPlayers - 1) and ID ~= game.JobId then
            local alreadyVisited = false
            for _, Existing in pairs(AllIDs) do
                if ID == tostring(Existing) then
                    alreadyVisited = true
                    break
                end
            end
            
            if not alreadyVisited then
                table.insert(validServers, ID)
            end
        end
    end
    
    if #validServers > 0 then
        return validServers[math.random(1, #validServers)]
    end
    
    return nil
end

function Teleport()
    local maxTime = 60
    local timeLeft = maxTime
    
    ProgressBar.Size = UDim2.new(1, 0, 1, 0)
    
    while timeLeft > 0 do
        CountdownLabel.Text = "Next Hop: " .. math.ceil(timeLeft) .. "s"
        local progress = timeLeft / maxTime
        TweenService:Create(ProgressBar, TweenInfo.new(1, Enum.EasingStyle.Linear), {
            Size = UDim2.new(progress, 0, 1, 0)
        }):Play()
        
        task.wait(1)
        timeLeft = timeLeft - 1
    end
    
    local attempts = 0
    local targetServer = nil
    
    while not targetServer and attempts < 5 do
        CountdownLabel.Text = "Searching... (" .. (attempts + 1) .. ")"
        targetServer = GetNextServerID()
        if not targetServer then
            attempts = attempts + 1
            task.wait(1)
        end
    end
    
    CountdownLabel.Text = "Server Hopping"
    
    if targetServer then
        table.insert(AllIDs, targetServer)
        pcall(writefile, "KyoOnTop", HttpService:JSONEncode(AllIDs))
        
        -- Try specific instance teleport first
        local tpSuccess = pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceID, targetServer, player)
        end)
        
        -- If specific instance fails, drop back to standard auto-matchmaking server hop
        if not tpSuccess then
            CountdownLabel.Text = "Fallback Hopping..."
            task.wait(1)
            pcall(function()
                TeleportService:Teleport(PlaceID, player)
            end)
        end
    else
        -- If API completely fails to find a valid server, use standard auto-matchmaking hop
        CountdownLabel.Text = "Auto Hopping..."
        AllIDs = {actualHour}
        foundAnything = ""
        pcall(writefile, "KyoOnTop", HttpService:JSONEncode(AllIDs))
        task.wait(1)
        
        pcall(function()
            TeleportService:Teleport(PlaceID, player)
        end)
    end
end

task.spawn(Teleport)
